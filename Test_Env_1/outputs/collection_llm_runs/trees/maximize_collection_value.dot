digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
root_selector [label="root_selector", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
goal_met [label="goal_met", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
root_selector -> goal_met;
goal_check [label="goal_check", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
goal_met -> goal_check;
succeed [label=succeed, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
goal_met -> succeed;
work_loop [label="work_loop", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
root_selector -> work_loop;
sense [label=sense, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
work_loop -> sense;
not_done [label="not_done", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
work_loop -> not_done;
goal_gate [label="goal_gate", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
not_done -> goal_gate;
continue [label=continue, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
not_done -> continue;
pick_or_replan [label="pick_or_replan", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
work_loop -> pick_or_replan;
collect_one [label="collect_one", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pick_or_replan -> collect_one;
has_capacity [label="has_capacity", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_one -> has_capacity;
choose_best [label="choose_best", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_one -> choose_best;
target_available [label="target_available", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_one -> target_available;
go_to_target [label="go_to_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_one -> go_to_target;
pickup [label=pickup, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_one -> pickup;
carry_or_drop [label="carry_or_drop", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
collect_one -> carry_or_drop;
holding_then_drop [label="holding_then_drop", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
carry_or_drop -> holding_then_drop;
is_holding [label="is_holding", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
holding_then_drop -> is_holding;
to_dropoff [label="to_dropoff", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
holding_then_drop -> to_dropoff;
deposit [label=deposit, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
holding_then_drop -> deposit;
replan [label=replan, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
carry_or_drop -> replan;
replan_fallback [label="replan_fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pick_or_replan -> replan_fallback;
}
