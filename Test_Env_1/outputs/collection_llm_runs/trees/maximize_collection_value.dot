digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Selector [label=Selector, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
Sequence [label=Sequence, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Selector -> Sequence;
SenseCollectionWorld [label=SenseCollectionWorld, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Sequence -> SenseCollectionWorld;
CollectionValueGoalMet [label=CollectionValueGoalMet, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Sequence -> CollectionValueGoalMet;
"Sequence*" [label="Sequence*", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Sequence -> "Sequence*";
HoldingObject [label=HoldingObject, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence*" -> HoldingObject;
NavigateToDropoff [label=NavigateToDropoff, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence*" -> NavigateToDropoff;
DepositHeldObject [label=DepositHeldObject, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence*" -> DepositHeldObject;
"Sequence**" [label="Sequence**", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Selector -> "Sequence**";
"SenseCollectionWorld*" [label="SenseCollectionWorld*", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence**" -> "SenseCollectionWorld*";
TimeRemaining [label=TimeRemaining, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence**" -> TimeRemaining;
CarryCapacityAvailable [label=CarryCapacityAvailable, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence**" -> CarryCapacityAvailable;
SelectBestMaterial [label=SelectBestMaterial, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence**" -> SelectBestMaterial;
"Selector*" [label="Selector*", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Sequence**" -> "Selector*";
"Sequence***" [label="Sequence***", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
"Selector*" -> "Sequence***";
ObjectStillAvailable [label=ObjectStillAvailable, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence***" -> ObjectStillAvailable;
NavigateToSelectedObject [label=NavigateToSelectedObject, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence***" -> NavigateToSelectedObject;
AttemptPickupSelectedObject [label=AttemptPickupSelectedObject, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Sequence***" -> AttemptPickupSelectedObject;
ReplanCollectionTarget [label=ReplanCollectionTarget, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Selector*" -> ReplanCollectionTarget;
}
