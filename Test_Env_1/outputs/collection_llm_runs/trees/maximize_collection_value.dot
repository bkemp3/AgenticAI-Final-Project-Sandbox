digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
main_loop [label="main_loop", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
goal_already_met [label="goal_already_met", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
main_loop -> goal_already_met;
sense_for_goal_check [label="sense_for_goal_check", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
goal_already_met -> sense_for_goal_check;
target_reached [label="target_reached", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
goal_already_met -> target_reached;
deposit_if_holding [label="deposit_if_holding", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
main_loop -> deposit_if_holding;
sense_before_deposit [label="sense_before_deposit", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
deposit_if_holding -> sense_before_deposit;
has_object [label="has_object", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
deposit_if_holding -> has_object;
enough_time_to_continue [label="enough_time_to_continue", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
deposit_if_holding -> enough_time_to_continue;
go_to_dropoff [label="go_to_dropoff", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
deposit_if_holding -> go_to_dropoff;
deposit_object [label="deposit_object", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
deposit_if_holding -> deposit_object;
collect_new_object [label="collect_new_object", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
main_loop -> collect_new_object;
sense_for_collection [label="sense_for_collection", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_new_object -> sense_for_collection;
have_time_to_collect [label="have_time_to_collect", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_new_object -> have_time_to_collect;
capacity_check [label="capacity_check", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_new_object -> capacity_check;
choose_best_visible_target [label="choose_best_visible_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
collect_new_object -> choose_best_visible_target;
approach_and_pick_or_replan [label="approach_and_pick_or_replan", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
collect_new_object -> approach_and_pick_or_replan;
pickup_flow [label="pickup_flow", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
approach_and_pick_or_replan -> pickup_flow;
target_available_initial [label="target_available_initial", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pickup_flow -> target_available_initial;
move_to_target [label="move_to_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pickup_flow -> move_to_target;
sense_at_target [label="sense_at_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pickup_flow -> sense_at_target;
target_available_final [label="target_available_final", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pickup_flow -> target_available_final;
pickup_target [label="pickup_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
pickup_flow -> pickup_target;
replan_if_target_invalid [label="replan_if_target_invalid", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
approach_and_pick_or_replan -> replan_if_target_invalid;
clear_target [label="clear_target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
replan_if_target_invalid -> clear_target;
}
